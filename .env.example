# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/guildhero

# Telegram bot token (get one from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# OpenAI API key (used for /summarize, /bestof, /vibecheck, /copypasta, /score)
OPENAI_API_KEY=your-openai-api-key

# ── Optional: Per-group encrypted airdrop wallets ─────────────────────────────

# 32-byte (64 hex chars) AES key used to encrypt group airdrop private keys.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Without this key the /setairdropwallet command is disabled.
AIRDROP_ENCRYPTION_KEY=

# ── Optional: Legacy global airdrop wallet ────────────────────────────────────

# SUI private key used as a fallback airdrop sender when no per-group wallet
# is configured.  Accepts suiprivkey1... or 64 hexadecimal characters.
SUI_PRIVATE_KEY=

# ── Optional: SUI RPC endpoint ───────────────────────────────────────────────

# Override the default SUI mainnet RPC node.
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
