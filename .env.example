# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/cityledger

# Telegram bot token (get one from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# OpenAI API key (used for /summarize, /bestof, /vibecheck, /copypasta, /score)
OPENAI_API_KEY=your-openai-api-key

# ── Optional: Per-group encrypted airdrop wallets ─────────────────────────────

# 32-byte (64 hex chars) AES key used to encrypt group airdrop private keys.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Without this key the /setairdropwallet command is disabled.
AIRDROP_ENCRYPTION_KEY=

# ── Optional: Legacy global airdrop wallet ────────────────────────────────────

# SUI private key used as a fallback airdrop sender when no per-group wallet
# is configured.  Accepts suiprivkey1... or 64 hexadecimal characters.
SUI_PRIVATE_KEY=

# ── Optional: Sui gRPC and buy-tracker settings ──────────────────────────────

# Override the default Sui mainnet gRPC endpoint. For production, use a
# dedicated provider endpoint rather than relying on the public rate limit.
SUI_GRPC_URL=https://fullnode.mainnet.sui.io:443

# Optional provider headers, such as an API key, encoded as a JSON object.
SUI_GRPC_HEADERS_JSON={}

# Maximum gas budget per airdrop transaction, in MIST (default: 0.05 SUI).
SUI_GAS_BUDGET=50000000

# Transaction link prefix used in buy announcements.
SUI_EXPLORER_TX_URL=https://suivision.xyz/txblock

# USD purchase value that earns the Whale Buy badge (default: 100).
BUYBOT_WHALE_USD_THRESHOLD=100

# Optional package-ID-to-exchange labels for DEX packages not built into the
# bot. Package IDs are normalized, so padded and short Sui addresses both work.
# Example: {"0xabc...":"My DEX","0xdef...":"Aggregator"}
SUI_DEX_PACKAGES_JSON={}

# Optional Node.js binary override. The Docker image already includes Node 22.
SUI_NODE_BINARY=node
